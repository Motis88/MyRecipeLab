{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug APK",
            "type": "shell",
            "command": ".\\gradlew.bat assembleDebug",
            "options": {
                "env": {
                    "JAVA_HOME": "C:\\Program Files\\Android\\Android Studio\\jbr"
                },
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "kotlin",
                "fileLocation": ["absolute"],
                "pattern": {
                    "regexp": "^(.+\\.kt):(\\d+):(\\d+): (error|warning): (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Open in Android Studio",
            "type": "shell",
            "command": "C:\\Program Files\\Android\\Android Studio\\bin\\studio64.exe",
            "args": [
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Open Android Studio",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug APK",
                "Open in Android Studio"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
